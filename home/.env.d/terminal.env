#!/bin/bash

# tmux does not forward COLORTERM, so 24-bit-aware tools (git-delta, bat, fzf)
# fall back to 256 colors and their subtle backgrounds turn into loud ones.
# Ask tmux what the attached client can actually do instead of guessing.
if [ -n "$TMUX" ]; then
    case "$(tmux display -p '#{client_termfeatures}' 2>/dev/null)" in
        *RGB*|*Tc*) export COLORTERM=truecolor ;;
    esac
fi
